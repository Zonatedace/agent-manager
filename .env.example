# Agent Manager — local environment (copy to `.env` and edit)
# `.env` is gitignored and must never be committed.

# Required for a stable scan root: folder that contains your project repos.
# Examples:
#   AGENT_MANAGER_ROOT=C:\Users\you\Desktop\Repos
#   AGENT_MANAGER_ROOT=/home/you/projects
#   AGENT_MANAGER_ROOT=D:\code
AGENT_MANAGER_ROOT=

# Optional overrides
# AGENT_MANAGER_PORT=7878
# AGENT_MANAGER_HOST=127.0.0.1
#   Use 0.0.0.0 if Windows clients on other machines should connect.
# AGENT_MANAGER_CONFIG=agent-manager.config.json
# AGENT_MANAGER_LOG_FILE=agent-manager.log
# AGENT_MANAGER_LOG_LEVEL=info

# Thin Windows client (--mode client)
# AGENT_MANAGER_SERVER_URL=http://127.0.0.1:7878/
# AGENT_MANAGER_CLIENT_CONFIG=agent-manager.client.json

# Coding agents (claude/grok/codex)
# Docker image always sets this to 0 (no CLIs in the container).
# On the Windows app host, leave unset or 1, then enable in Settings.
# AGENT_MANAGER_ALLOW_AGENTS=1
